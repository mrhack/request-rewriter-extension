// === Mock Chrome APIs ===
const mockStorage = { local: {}, session: { attachedTabs: [] } };

globalThis.chrome = {
  storage: {
    local: {
      get: async (key) => ({ [key]: mockStorage.local[key] }),
      set: async (obj) => { Object.assign(mockStorage.local, obj); },
    },
    session: {
      get: async (key) => ({ [key]: mockStorage.session[key] }),
      set: async (obj) => { Object.assign(mockStorage.session, obj); },
    }
  },
  runtime: {
    onMessage: { addListener: () => {} },
    onInstalled: { addListener: () => {} },
    sendMessage: async (msg) => {
      if (msg.type === 'getConfig') {
        return { ok: true, config: mockStorage.local.config || { rules: [] } };
      }
      if (msg.type === 'saveConfig') {
        mockStorage.local.config = msg.config;
        return { ok: true };
      }
      if (msg.type === 'status') return { ok: true, attached: false };
      if (msg.type === 'attach') return { ok: true, attached: true };
      if (msg.type === 'detach') return { ok: true, attached: false };
      return { ok: true };
    }
  },
  tabs: { query: async () => [{ id: 1 }] },
  action: { setBadgeText: async () => {}, setBadgeBackgroundColor: async () => {} },
  debugger: { attach: async () => {}, detach: async () => {}, sendCommand: async () => {}, getTargets: async () => [], onEvent: { addListener: () => {} }, onDetach: { addListener: () => {} } }
};

// Helper: read current storage state
window.__getStorage = () => JSON.parse(JSON.stringify(mockStorage.local));
window.__clearStorage = () => { mockStorage.local = {}; };

try {
  await import('../popup.js');
} catch(e) {
  document.body.insertAdjacentHTML('beforeend', `<div style="color:red;padding:10px;">popup.js load error: ${e.message}</div>`);
}
